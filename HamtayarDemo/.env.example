# Copy to .env. Never commit .env. Restart backend after changes.
CGC_EXECUTABLE=D:/CGC/CodeGraphContext/.venv/Scripts/cgc.exe
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=
# Dedicated staging only! Never point this at your existing populated database.
STAGING_NEO4J_URI=bolt://127.0.0.1:7689
STAGING_NEO4J_USERNAME=neo4j
STAGING_NEO4J_DATABASE=neo4j
STAGING_NEO4J_PASSWORD=
MAX_UPLOAD_MB=1024
MAX_EXPANDED_MB=8192
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Optional RAR decoder paths. Auto-detects WinRAR/UnRAR.exe and 7-Zip/7z.exe in Program Files.
RAR_UNRAR_TOOL=
RAR_7ZIP_TOOL=

MAX_ARCHIVE_FILES=250000
MAX_SOURCE_FILE_MB=25

# Indexing scope is separate from upload/extraction limits. 0 disables size filter.
# Excluded files remain viewable as source but are not analyzed in the graph.
INDEX_MAX_FILE_MB=2
INDEX_EXCLUDE_GLOBS=*.min.js,*.min.css,*.map
INDEX_PARALLEL_WORKERS=2
INDEX_TIMEOUT_SECONDS=7200

# Graph publication: streamed reads and bounded writes, independent of UI's 300-edge view.
GRAPH_MAX_NODES=1000000
GRAPH_MAX_RELATIONSHIPS=5000000
GRAPH_PUBLISH_BATCH_SIZE=500
GRAPH_QUERY_TIMEOUT_SECONDS=1800

# OpenAI-compatible model endpoint. Local servers may leave LLM_API_KEY empty.
LLM_API_STYLE=chat_completions
LLM_TOKEN_PARAMETER=max_tokens
LLM_TIMEOUT_SECONDS=90
